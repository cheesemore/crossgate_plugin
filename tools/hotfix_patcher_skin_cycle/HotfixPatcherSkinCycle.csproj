<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HotfixPatcherSkinCycle</AssemblyName>
    <RootNamespace>CrossgateMod.Patcher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- 链接主引擎源码（只读复用），排除其 Program 与 stub / 测试子目录 -->
    <Compile Include="..\hotfix_patcher\*.cs" Exclude="..\hotfix_patcher\Program.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="WikiSkinCycleExternalIlPatcher.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
</Project>
